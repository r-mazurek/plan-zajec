{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plan-zajec",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plan-zajec",
      "database_id": "b1fa2f42-d414-4721-99ee-70680782b618",
      "migrations_dir": "migrations",
    },
  ],
  // Every 15 minutes; the Worker decides which reminders are due in Europe/Warsaw time.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BIEKXXdGimUk2eun6yn3uLDgspThDowXUS0ekx3YTtmj8V0oIsf6o-CPY1UAnRR5aFyGBHfb6dRGSeaoRiyOEsI",
    // Contact address push services can reach if something goes wrong. Use your own.
    "VAPID_SUBJECT": "mailto:you@example.com",
    // Set ACCESS_TEAM_DOMAIN and ACCESS_AUD once Cloudflare Access is in front of the app.
  },
  "observability": { "enabled": true },
}
