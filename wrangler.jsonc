{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plan-zajec",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plan-zajec",
      "database_id": "b1fa2f42-d414-4721-99ee-70680782b618",
      "migrations_dir": "migrations",
    },
  ],
  // Every 15 minutes; the Worker decides which reminders are due in Europe/Warsaw time.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BJ6-7LiktjW9yHwCATm0c4vdDK_OL7Uazfybm78M-yf5zN_dzIPWmud8kTF8AMVqarZJxLEoaPJMg3sDVv_vgEA",
    // Contact address push services can reach if something goes wrong. Use your own.
    "VAPID_SUBJECT": "mailto:rafalm2404@gmail.com",
    // Cloudflare Access in front of the app; without these the API refuses every request.
    "ACCESS_TEAM_DOMAIN": "lucky-wind-488b.cloudflareaccess.com",
    "ACCESS_AUD": "7c6c2abde6ae0260d2488f1c1279919f3c8cec2f82f94b805a6eb1c4ab77e6ee",
  },
  "observability": { "enabled": true },
}
